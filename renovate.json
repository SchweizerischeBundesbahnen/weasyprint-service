{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>SchweizerischeBundesbahnen/casc-renovate-preset-polarion-docker"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "semanticCommitType": "feat",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchPackageNames": [
        "weasyprint"
      ]
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "semanticCommitType": "feat!",
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "weasyprint"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "semanticCommitType": "chore",
      "commitMessageTopic": "Python Docker image version",
      "automerge": false
    },
    {
      "description": "weasysvg and weasyvsdx are ours and change what the service draws: take each release at once, and review it",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "weasysvg",
        "weasyvsdx"
      ],
      "minimumReleaseAge": "0 days",
      "automerge": false
    },
    {
      "description": "A minor release of weasysvg or weasyvsdx is a feature of the service: release-please takes it as a minor release",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "weasysvg",
        "weasyvsdx"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "semanticCommitType": "feat"
    },
    {
      "description": "A major release of weasysvg or weasyvsdx may change what a document looks like: release-please takes it as a major release",
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "weasysvg",
        "weasyvsdx"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "feat!"
    }
  ]
}
